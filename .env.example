# API base used by the browser. Keep /api — Next.js rewrites it to API_PROXY_TARGET.
NEXT_PUBLIC_API_URL=/api
# Your PHP backend (server-side only, used by the /api and /media rewrites)
API_PROXY_TARGET=http://mithudi.mooo.com
# Same origin as above — image URLs on this host are loaded through /media
NEXT_PUBLIC_PHP_ORIGIN=http://mithudi.mooo.com
# Relative image paths from the DB ("uploads/a.jpg") live in /api/uploads -> /media/api/uploads/a.jpg
NEXT_PUBLIC_IMAGE_BASE=/media/api/
# POST body format: "json" (PHP reads php://input) or "form" (PHP reads $_POST)
NEXT_PUBLIC_API_BODY_FORMAT=json
# Google Sign-In web client ID (optional — the Google button is hidden when blank)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# WhatsApp number for the chat button, with country code and no "+"
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
# Public site URL, used for canonical links, sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://mithudi.in
# Show the coupon box in cart/checkout. Turn on (1) only after orders/create.php applies coupon_code.
NEXT_PUBLIC_ENABLE_COUPONS=0
